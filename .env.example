# ==============================================================================
# MIZAN PLATFORM ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Environment: 'development' or 'production'
APP_ENV=development
DEBUG=true
APP_NAME="Mizan"

# Cryptographic Secret Key (Generate with: openssl rand -hex 32)
SECRET_KEY=change-this-to-a-secure-random-64-character-hex-string-for-production

# Primary Database Connection URL
# For local SQLite: sqlite:///./storage/development/mizan.db
# For production MySQL 8: mysql+pymysql://mizan_user:YourStrongPassword@localhost:3306/mizan_production
DATABASE_URL=sqlite:///./storage/development/mizan.db

# CORS Allowed Origins (JSON array of strings)
# Include your Hostinger domain (e.g. "https://yourdomain.com") and local dev origins
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","https://yourdomain.com"]

# Frontend Public URL (Used for generating clickable verification & password-reset links)
FRONTEND_URL=http://localhost:5173

# Cookie Security (Set to true in production with HTTPS)
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=lax

# ==============================================================================
# HOSTINGER EMAIL / SMTP CONFIGURATION
# (Required for sending real verification, password reset, and invitation emails)
# ==============================================================================
# Hostinger Business Hosting SMTP Server: smtp.hostinger.com
SMTP_ENABLED=true
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=no-reply@yourdomain.com
SMTP_PASSWORD=your_hostinger_email_password
SMTP_FROM_EMAIL=no-reply@yourdomain.com
SMTP_FROM_NAME="Mizan Platform"
SMTP_USE_SSL=true
SMTP_USE_TLS=false

# ==============================================================================
# BACKUP & DISASTER RECOVERY (M15)
# ==============================================================================
# High-entropy passphrase for AES-256-GCM cold database backups
BACKUP_PASSPHRASE=generate-a-strong-random-backup-passphrase-here

# ==============================================================================
# OPTIONAL AI PROVIDERS
# ==============================================================================
DEFAULT_LLM_PROVIDER=mock
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
# GEMINI_API_KEY=your_gemini_api_key_here
